# ============================================================================
#  Mahabharata Wisdom AI — environment template
#  Copy to `.env` and adjust. Every value below has a working default, so the
#  app boots with zero configuration (local storage + local embeddings +
#  deterministic, evidence-only answer composition).
# ============================================================================

# ------------------------------- general -----------------------------------
APP_NAME="Mahabharata Wisdom AI"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------- storage -----------------------------------
# local    -> SQLite file + numpy vectors (no external services required)
# postgres -> PostgreSQL with the pgvector extension (production)
STORAGE_BACKEND=local
SQLITE_PATH=./data/mahabharata.db
POSTGRES_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mahabharata
VECTOR_DIM=512

# ----------------------------- embeddings ----------------------------------
# local   -> deterministic hashed n-gram embeddings, no API key needed
# openai  -> text-embedding-3-small
# gemini  -> text-embedding-004
EMBEDDING_PROVIDER=local

# -------------------------------- LLM --------------------------------------
# none     -> no LLM available
# openai | anthropic | gemini
LLM_PROVIDER=none
# auto -> use an LLM whenever a key is configured, otherwise fall back to the
#         deterministic template generator (which never invents text).
GENERATOR=auto
ANALYST=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2600
HTTP_TIMEOUT_SECONDS=60

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------ retrieval ----------------------------------
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=8
RERANK_TOP_K=6
MIN_SEMANTIC_SCORE=0.05
# Minimum relevance (0-1) for a passage to be labelled "strong textual support".
STRONG_SUPPORT_THRESHOLD=0.34
# Never return passages below this relevance, even if we are short on evidence.
MIN_RELEVANCE_CUT=0.06
# Only passages whose source is flagged as primary text can earn
# "strong textual support".
REQUIRE_PRIMARY_TEXT_FOR_STRONG_SUPPORT=true

# -------------------------------- auth -------------------------------------
# Required in production. It also protects all admin operations.
AUTH_REQUIRED=false
# Production requires a unique JWT_SECRET of at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
# Created on first boot when no admin exists. Change both values before production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Corpus Administrator

# ------------------------------- daily -------------------------------------
# salt for the deterministic "Daily Reflection" rotation
REFLECTION_SEED=mahabharata-wisdom
